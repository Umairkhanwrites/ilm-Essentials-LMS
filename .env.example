# ============================================================================
# CAPROVER BUILD-TIME VARIABLES (Safe for Browser Bundle — Add to CapRover)
# Paste these in CapRover -> App Configs -> Environmental Variables (Bulk Edit)
# ============================================================================

# Supabase PostgreSQL Database & Auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase (Auth & Firestore Student Sync)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ============================================================================
# SERVER / EDGE FUNCTION SECRETS ONLY (DO NOT add to CapRover frontend build)
# Set in Supabase Dashboard -> Edge Functions -> Secrets (supabase secrets set)
# ============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
